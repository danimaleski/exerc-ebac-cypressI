{
  "name": "exerc-ebac-cypressi",
  "version": "1.0.0",
  "description": "Exercício CI com Git Hub Actions",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run", 
    "merge-reports": "mochawesome-merge cypress/reports/*.json > cypress/reports/output.json",
    "generate-report": "marge cypress/reports/output.json -f report -o cypress/reports/html",
    "test:report": "npm run test && npm run merge-reports && npm run generate-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danimaleski/exerc-ebac-cypressI.git"
  },
  "author": "daniella",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danimaleski/exerc-ebac-cypressI/issues"
  },
  "homepage": "https://github.com/danimaleski/exerc-ebac-cypressI#readme",
  "devDependencies": {
    "cypress": "^14.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
