{
  "name": "exerc-ebac-cypressi",
  "version": "1.0.0",
  "description": "Exercício CI com Git Hub Actions",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress run --reporter mochawesome --reporter-options reportDir=mochawesome-report,html=true,json=true",
  "test:report": "npx mochawesome-merge ./mochawesome-report/mochawesome*.json > mochawesome-report/report.json && npx marge mochawesome-report/report.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danimaleski/exerc-ebac-cypressI.git"
  },
  "author": "daniella",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danimaleski/exerc-ebac-cypressI/issues"
  },
  "homepage": "https://github.com/danimaleski/exerc-ebac-cypressI#readme",
  "devDependencies": {
    "cypress": "^14.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
